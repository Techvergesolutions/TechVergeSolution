{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "techvergesolution.com" }],
      "destination": "https://www.techvergesolution.com/:path*",
      "permanent": true
    },
    {
      "source": "/ai-automation",
      "destination": "/services/ai-automation",
      "permanent": true
    },
    {
      "source": "/ai-voice-agents",
      "destination": "/services/ai-voice-agents",
      "permanent": true
    },
    {
      "source": "/business-automation",
      "destination": "/services/business-automation",
      "permanent": true
    },
    {
      "source": "/ai-saas-development",
      "destination": "/services/ai-saas-development",
      "permanent": true
    },
    {
      "source": "/lead-follow-up-automation",
      "destination": "/services/ai-automation",
      "permanent": true
    },
    {
      "source": "/services/lead-follow-up-automation",
      "destination": "/services/ai-automation",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms-of-service",
      "permanent": true
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
