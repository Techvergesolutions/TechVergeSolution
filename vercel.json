{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/ai-automation",
      "status": 308,
      "headers": { "Location": "/services/ai-automation" }
    },
    {
      "src": "/ai-voice-agents",
      "status": 308,
      "headers": { "Location": "/services/ai-voice-agents" }
    },
    {
      "src": "/business-automation",
      "status": 308,
      "headers": { "Location": "/services/business-automation" }
    },
    {
      "src": "/ai-saas-development",
      "status": 308,
      "headers": { "Location": "/services/ai-saas-development" }
    },
    {
      "src": "/lead-follow-up-automation",
      "status": 308,
      "headers": { "Location": "/services/ai-automation" }
    },
    {
      "src": "/services/lead-follow-up-automation",
      "status": 308,
      "headers": { "Location": "/services/ai-automation" }
    },
    {
      "src": "/privacy",
      "status": 308,
      "headers": { "Location": "/privacy-policy" }
    },
    {
      "src": "/terms",
      "status": 308,
      "headers": { "Location": "/terms-of-service" }
    },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
