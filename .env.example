# Copy to .env.local for local development. Never commit real secrets.
# Public values below are safe in the client bundle.

# Public Google Calendar / booking schedule URL
VITE_BOOKING_URL=https://calendar.app.google/7yTLTVakoD34aXGk7

# Sanity — public project settings only (safe in client bundle).
VITE_SANITY_PROJECT_ID=xo7s2xmj
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# ---------------------------------------------------------------------------
# Server / CI only — DO NOT prefix with VITE_ (never ship in the browser bundle).
# Set these in Vercel → Settings → Environment Variables (and optionally .env.local).
# ---------------------------------------------------------------------------

# Optional: Sanity read token for build-time fetch if the dataset is private.
# Public production datasets usually need no token (CDN + published docs only).
# SANITY_API_READ_TOKEN=

# Sanity → site rebuild webhook (api/sanity-rebuild.ts)
# SANITY_WEBHOOK_SECRET=generate_a_long_random_string
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# Contact form (api/send-email.ts)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@techvergesolution.com
