# Google Calendar Appointment Schedule booking page (or Calendly).
# Public schedule link — set the same value in Vercel Production for live.
VITE_BOOKING_URL=https://calendar.app.google/7yTLTVakoD34aXGk7

# Legacy alias (same behavior as VITE_BOOKING_URL):
# VITE_CALENDLY_URL=

# Sanity CMS (blog). Copy to .env.local for local dev; set in Vercel for production.
# Use a Viewer (read) token — never commit the real token.
VITE_SANITY_PROJECT_ID=xo7s2xmj
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
VITE_SANITY_TOKEN=

